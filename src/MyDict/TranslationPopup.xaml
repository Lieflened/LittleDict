<Window x:Class="MyDict.TranslationPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxWidth="420"
        MaxHeight="320">
    <Border Background="#F2FFFFFF"
            BorderBrush="#22000000"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>
        <!-- <TextBlock x:Name="ContentTextBlock"
                   Text="..."
                   FontSize="18"
                   TextWrapping="Wrap"
                   Foreground="#222"/> -->
        <StackPanel>
            <TextBlock x:Name="SourceTextBlock"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#333"
                    TextWrapping="Wrap"
                    MaxWidth="380"/>

            <Border Height="1" Background="#11000000" Margin="0,8,0,8"/>

            <TextBlock x:Name="TranslationTextBlock"
                    FontSize="18"
                    Foreground="#222"
                    TextWrapping="Wrap"
                    MaxWidth="380"/>
        </StackPanel>
    </Border>
</Window>